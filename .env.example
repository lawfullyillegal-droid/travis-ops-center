# Docker/server deployments MUST set both values.
# Direct loopback-only development may leave both blank.
AUTH_USER=
AUTH_PASS=

# Host-side Docker port exposure. Keep loopback unless you intentionally
# place the app behind an authenticated reverse proxy/VPN.
PUBLIC_BIND_HOST=127.0.0.1
SERVER_PORT=8080

# Direct Python run binding. 127.0.0.1 is the safe default.
SERVER_HOST=127.0.0.1

FLASK_ENV=production

# Emergency override only. Do not enable on an untrusted network.
ALLOW_INSECURE_NO_AUTH=0
