[32m+[m[32m#!/usr/bin/env python3[m
[32m+[m[32m"""Validate and review a local CASEOPS timeline without fetching source links."""[m
[32m+[m[32mfrom __future__ import annotations[m
[32m+[m
[32m+[m[32mimport argparse[m
[32m+[m[32mimport csv[m
[32m+[m[32mimport hashlib[m
[32m+[m[32mimport io[m
[32m+[m[32mimport json[m
[32m+[m[32mimport sys[m
[32m+[m[32mfrom collections import Counter[m
[32m+[m[32mfrom datetime import date[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m[32mfrom urllib.parse import urlsplit[m
[32m+[m
[32m+[m[32mFIELDS = ("date", "docket_scope", "event", "source_status", "source_url")[m
[32m+[m[32mSCOPES = {"civil", "criminal", "system"}[m
[32m+[m
[32m+[m
[32m+[m[32mdef read_timeline(path: Path) -> tuple[list[dict[str, str]], str]:[m
[32m+[m[32m    raw = path.read_bytes()[m
[32m+[m[32m    reader = csv.DictReader(io.StringIO(raw.decode("utf-8-sig")), strict=True)[m
[32m+[m[32m    if reader.fieldnames != list(FIELDS):[m
[32m+[m[32m        raise ValueError("CSV header must be: " + ",".join(FIELDS))[m
[32m+[m[32m    rows = [][m
[32m+[m[32m    for row in reader:[m
[32m+[m[32m        line = reader.line_num[m
[32m+[m[32m        if None in row or any(row.get(key) is None for key in FIELDS):[m
[32m+[m[32m            raise ValueError(f"line {line}: expected exactly five columns")[m
[32m+[m[32m        if any(not row[key].strip() for key in FIELDS):[m
[32m+[m[32m            raise ValueError(f"line {line}: fields must not be blank")[m
[32m+[m[32m        if any(any(ord(char) < 32 and char not in "\n\r\t" for char in value)[m
[32m+[m[32m               for value in row.values()):[m
[32m+[m[32m            raise ValueError(f"line {line}: unsupported control character")[m
[32m+[m[32m        try:[m
[32m+[m[32m            parsed = date.fromisoformat(row["date"])[m
[32m+[m[32m        except ValueError as exc:[m
[32m+[m[32m            raise ValueError(f"line {line}: invalid date") from exc[m
[32m+[m[32m        if parsed.isoformat() != row["date"]:[m
[32m+[m[32m            raise ValueError(f"line {line}: date must use YYYY-MM-DD")[m
[32m+[m[32m        if row["docket_scope"] not in SCOPES:[m
[32m+[m[32m            raise ValueError(f"line {line}: scope must be civil, criminal, or system")[m
[32m+[m[32m        try:[m
[32m+[m[32m            url = urlsplit(row["source_url"])[m
[32m+[m[32m            valid_url = (url.scheme == "https" and bool(url.hostname)[m
[32m+[m[32m                         and url.username is None and url.password is None[m
[32m+[m[32m                         and not any(char.isspace() for char in row["source_url"]))[m
[32m+[m[32m            url.port[m
[32m+[m[32m        except ValueError:[m
[32m+[m[32m            valid_url = False[m
[32m+[m[32m        if not valid_url:[m
[32m+[m[32m            raise ValueError(f"line {line}: source_url must be an HTTPS URL without credentials")[m
[32m+[m[32m        rows.append(row)[m
[32m+[m[32m    if not rows:[m
[32m+[m[32m        raise ValueError("timeline must contain at least one event")[m
[32m+[m[32m    return sorted(rows, key=lambda row: row["date"]), hashlib.sha256(raw).hexdigest()[m
[32m+[m
[32m+[m
[32m+[m[32mdef render(rows: list[dict[str, str]], digest: str, include_links: bool = False) -> str:[m
[32m+[m[32m    counts = Counter(row["docket_scope"] for row in rows)[m
[32m+[m[32m    lines = ["CASEOPS // TIMELINE", f"Events: {len(rows)} | " + " | ".join([m
[32m+[m[32m        f"{scope}: {counts[scope]}" for scope in sorted(SCOPES)),[m
[32m+[m[32m        f"Range: {rows[0]['date']} to {rows[-1]['date']}", f"CSV SHA-256: {digest}",[m
[32m+[m[32m        "Source statuses are supplied descriptions; source contents have not been verified.", ""][m
[32m+[m[32m    for row in rows:[m
[32m+[m[32m        # JSON quoting prevents terminal escapes and makes embedded newlines explicit.[m
[32m+[m[32m        lines.append(f"{row['date']} [{row['docket_scope']}] " + json.dumps(row["event"], ensure_ascii=False))[m
[32m+[m[32m        lines.append("  Status: " + json.dumps(row["source_status"], ensure_ascii=False))[m
[32m+[m[32m        if include_links:[m
[32m+[m[32m            lines.append("  Source: " + json.dumps(row["source_url"], ensure_ascii=False))[m
[32m+[m[32m    return "\n".join(lines) + "\n"[m
[32m+[m
[32m+[m
[32m+[m[32mdef main(argv: list[str] | None = None) -> int:[m
[32m+[m[32m    parser = argparse.ArgumentParser(description=__doc__)[m
[32m+[m[32m    parser.add_argument("csv", type=Path)[m
[32m+[m[32m    parser.add_argument("--scope", choices=sorted(SCOPES), help="show only one docket scope")[m
[32m+[m[32m    parser.add_argument("--include-links", action="store_true", help="include private source URLs in output")[m
[32m+[m[32m    parser.add_argument("--check", action="store_true", help="validate without printing case details")[m
[32m+[m[32m    args = parser.parse_args(argv)[m
[32m+[m[32m    try:[m
[32m+[m[32m        rows, digest = read_timeline(args.csv.expanduser())[m
[32m+[m[32m    except (OSError, UnicodeError, csv.Error, ValueError) as exc:[m
[32m+[m[32m        print(f"FAIL: {exc}", file=sys.stderr)[m
[32m+[m[32m        return 1[m
[32m+[m[32m    if args.check:[m
[32m+[m[32m        print(f"PASS: {len(rows)} events; CSV SHA-256: {digest}")[m
[32m+[m[32m        return 0[m
[32m+[m[32m    if args.scope:[m
[32m+[m[32m        rows = [row for row in rows if row["docket_scope"] == args.scope][m
[32m+[m[32m    if not rows:[m
[32m+[m[32m        print(f"No events for scope: {args.scope}")[m
[32m+[m[32m        return 0[m
[32m+[m[32m    print(render(rows, digest, args.include_links), end="")[m
[32m+[m[32m    return 0[m
[32m+[m
[32m+[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    raise SystemExit(main())[m
